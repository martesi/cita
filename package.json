    "brotli-wasm": "3.0.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.5.0",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
