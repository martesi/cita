{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cita",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cita",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/mcp", "/api/*", "/r/*"]
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
